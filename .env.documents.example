# Document Upload Feature Environment Variables
# Copy this file to .env.local and fill in your AWS credentials

# AWS S3 Configuration
# Get these from AWS Console: https://console.aws.amazon.com/iam/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET_NAME=bankchase-uploads

# Optional: S3 Bucket Settings
# AWS_S3_ENDPOINT=https://s3.amazonaws.com  # For non-standard S3 endpoints
# AWS_S3_ACL=private                        # Object ACL (private, public-read, etc.)

# Optional: File Upload Limits
# FILE_UPLOAD_MAX_SIZE=10485760            # 10MB in bytes (default)
# FILE_UPLOAD_TIMEOUT=60000                # Upload timeout in ms (default: 60s)
