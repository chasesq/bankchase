{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "tags": ["ci"]
    },
    "lint": {
      "outputs": [],
      "tags": ["ci"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "tags": ["ci"]
    }
  }
}
