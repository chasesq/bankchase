# ===========================================
# NOTIFICATION SYSTEM CONFIGURATION
# ===========================================
# Copy this file to .env.local and fill in your API keys

# EMAIL NOTIFICATIONS (Resend)
# ============================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address to send from (must be verified in Resend)
SENDER_EMAIL=alerts@bankchase.app

# SMS NOTIFICATIONS (Termii)
# ==========================
# Get API key from: https://termii.com/dashboard/api-tokens
TERMII_API_KEY=TLpxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS sender ID (max 11 characters, alphanumeric)
SMS_SENDER_ID=BankChase

# PAYSTACK CONFIGURATION
# ======================
# Get keys from: https://dashboard.paystack.co/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# APPLICATION URLs
# ================
APP_URL=http://localhost:3000

# NOTIFICATION PREFERENCES (Optional)
# ===================================
# Enable/disable specific notification channels
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# SMS Rate limiting (requests per minute)
SMS_RATE_LIMIT=10

# Email rate limiting (requests per minute)
EMAIL_RATE_LIMIT=20
