# Paystack Configuration
# Get these from https://dashboard.paystack.com/settings/developers

# Paystack Secret Key (for server-side operations)
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Paystack Public Key (optional, for client-side)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Transfer Settings
PAYSTACK_PREFERRED_BANK=wema-bank # wema-bank or providus-bank

# Webhook Configuration
PAYSTACK_WEBHOOK_URL=https://yourdomain.com/api/paystack/webhooks

# Transfer Limits (in major units - ₦)
MAX_TRANSFER_AMOUNT=10000000
MIN_TRANSFER_AMOUNT=100

# Recipient Bank Codes (common ones)
# GTB: 058
# Access: 044
# First Bank: 011
# Zenith: 057
# UBA: 033
# Wema: 035
# FCMB: 011

# Email Notifications
PAYMENT_NOTIFICATION_EMAIL=noreply@bankchase.com
ADMIN_EMAIL=admin@bankchase.com

# SMS Notifications (optional)
SMS_PROVIDER=twilio # or 'vonage', 'africastalking'
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret

# Stripe Configuration (optional alternative/backup)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Database
DATABASE_URL=postgresql://user:password@localhost/bankchase

# Logging
LOG_LEVEL=debug # debug, info, warn, error
